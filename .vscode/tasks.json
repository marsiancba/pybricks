{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run-on-spike-usb",
            "type": "shell",
            "command": "py",
            "args": [
                "-m",
                "pybricksdev",
                "run",
                "usb",
                "${workspaceFolder}/formel.py"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "run-on-spike-ble",
            "type": "shell",
            "command": "py",
            "args": [
                "-m",
                "pybricksdev",
                "run",
                "ble",
                "${workspaceFolder}/formel.py"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "compile-pybricks",
            "type": "shell",
            "command": "py",
            "args": [
                "-m",
                "pybricksdev",
                "compile",
                "${workspaceFolder}/formel.py"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
